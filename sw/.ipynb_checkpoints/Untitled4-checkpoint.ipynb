   "source": [
    "import turtle \n",
    "t= turtle.Turtle)_\n",
    "t.color('red')\n",
    "t.begin_fill()\n",
    "\n",
    "t.left(140)\n",
    "t.forward(180)\n",
    "t.circle(-90,200)\n",
    "t.left(120)\n",
    "t.circle(-90,200)\n",
    "t.forward(180)\n",
    "\n",
    "t.end_fill()\n",
    "t.hideturtle()\n",
    "\n",
    "turtle.done()"
   ]
  }
